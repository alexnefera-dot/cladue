{
  "name": "pipboy-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "local.pipboy",
    "productName": "Pipboy",
    "mac": { "category": "public.app-category.productivity" },
    "files": ["main.js", "../app/**/*", "!../app/data.db", "!../app/backups", "!../app/export"]
  }
}
