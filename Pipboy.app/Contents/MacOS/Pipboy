#!/bin/zsh
# Двойной клик по Pipboy.app: поднимает сервер и открывает окно-приложение.
# Без терминала, без Electron. Репозиторий — на три уровня выше этого файла.
ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$ROOT"
/usr/bin/git pull --quiet 2>/dev/null
/usr/sbin/lsof -ti:7777 2>/dev/null | xargs kill 2>/dev/null
cd "$ROOT/app"

URL="http://localhost:7777"
open_window() {
  for B in \
    "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" \
    "/Applications/Brave Browser.app/Contents/MacOS/Brave Browser" \
    "/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge"; do
    [ -x "$B" ] && { "$B" --app="$URL" --window-size=1380,900 >/dev/null 2>&1 & return 0; }
  done
  open "$URL"
}
( sleep 1.6; open_window ) &

# node может быть в разных местах — ищем
NODE="$(command -v node || echo /usr/local/bin/node)"
[ -x "$NODE" ] || NODE="/opt/homebrew/bin/node"
exec "$NODE" server.js
