#!/bin/zsh
# Двойной клик: сервер в фоне + НАТИВНЫЙ замок macOS на старте.
# Сначала системное окно с паролем, потом приложение открывается уже разблокированным.
ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
URL="http://localhost:7777"
osa() { /usr/bin/osascript "$@"; }

# 1) поднять сервер в фоне, если ещё не запущен
if ! /usr/bin/curl -s -o /dev/null --max-time 1 "$URL"; then
  cd "$ROOT"; /usr/bin/git pull --quiet 2>/dev/null
  cd "$ROOT/app"
  NODE="$(command -v node 2>/dev/null)"
  [ -x "$NODE" ] || NODE="/opt/homebrew/bin/node"
  [ -x "$NODE" ] || NODE="/usr/local/bin/node"
  /usr/sbin/lsof -ti:7777 2>/dev/null | xargs kill 2>/dev/null
  nohup "$NODE" server.js > "$ROOT/app/server.log" 2>&1 &
  for i in {1..60}; do /usr/bin/curl -s -o /dev/null --max-time 1 "$URL" && break; sleep 0.25; done
fi

# 2) замок включён? — нативное окно пароля macOS
KEY=""
LOCK="$(/usr/bin/curl -s --max-time 2 "$URL/api/lock")"
if echo "$LOCK" | grep -q '"enabled":true'; then
  while true; do
    PW="$(osa -e 'display dialog "Pipboy — пароль" default answer "" with hidden answer with title "Pipboy" buttons {"Отмена","Войти"} default button "Войти" with icon note' -e 'text returned of result' 2>/dev/null)"
    [ $? -ne 0 ] && exit 0          # нажали «Отмена» — не открываем
    ESC="${PW//\\/\\\\}"; ESC="${ESC//\"/\\\"}"
    RESP="$(/usr/bin/curl -s --max-time 3 -X POST "$URL/api/lock/unlock" -H 'Content-Type: application/json' -d "{\"password\":\"$ESC\"}")"
    KEY="$(echo "$RESP" | sed -n 's/.*"key":"\([^"]*\)".*/\1/p')"
    [ -n "$KEY" ] && break
    osa -e 'display dialog "Неверный пароль" with title "Pipboy" buttons {"Ещё раз"} default button "Ещё раз" with icon stop' >/dev/null 2>&1
  done
  OPEN_URL="$URL/?key=$KEY"
else
  OPEN_URL="$URL"
fi

# 3) открыть окно-приложение (Chrome/Brave/Edge без вкладок), иначе браузер
for B in \
  "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" \
  "/Applications/Brave Browser.app/Contents/MacOS/Brave Browser" \
  "/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge"; do
  [ -x "$B" ] && { "$B" --app="$OPEN_URL" --window-size=1380,900 >/dev/null 2>&1 & exit 0; }
done
open "$OPEN_URL"
