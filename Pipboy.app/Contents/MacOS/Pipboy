#!/bin/zsh
# Двойной клик: сервер работает в фоне (переживает закрытие окна),
# а каждый клик просто открывает окно-приложение. Без терминала, без Electron.
ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
URL="http://localhost:7777"

# сервер ещё не поднят? — обновим код и запустим в фоне
if ! /usr/bin/curl -s -o /dev/null --max-time 1 "$URL"; then
  cd "$ROOT"; /usr/bin/git pull --quiet 2>/dev/null
  cd "$ROOT/app"
  NODE="$(command -v node 2>/dev/null)"
  [ -x "$NODE" ] || NODE="/opt/homebrew/bin/node"
  [ -x "$NODE" ] || NODE="/usr/local/bin/node"
  /usr/sbin/lsof -ti:7777 2>/dev/null | xargs kill 2>/dev/null
  nohup "$NODE" server.js > "$ROOT/app/server.log" 2>&1 &
  for i in {1..60}; do /usr/bin/curl -s -o /dev/null --max-time 1 "$URL" && break; sleep 0.25; done
fi

# открыть окно-приложение (Chrome/Brave/Edge — без вкладок и адресной строки)
for B in \
  "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" \
  "/Applications/Brave Browser.app/Contents/MacOS/Brave Browser" \
  "/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge"; do
  [ -x "$B" ] && { "$B" --app="$URL" --window-size=1380,900 >/dev/null 2>&1 & exit 0; }
done
open "$URL"
