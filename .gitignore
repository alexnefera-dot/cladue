# секреты — ключ Anthropic для realize.php (в репозиторий не попадает)
engine/.anthropic-key
.anthropic-key
.env

# генерируемые артефакты анализатора
engine/tests/fixtures/
engine/tests/report.json
report.json
*.log

# сгенерированные прогоны (локально, не коммитить)
runs/
/tmp-runs/

# черновые замеры реалайзеров: пишутся рядом с движком на время прогона
engine/tmp-*.php
engine/dump-v3.php

# журнал выданных картинок (локальный, не коммитить)
engine/.image-ledger

# снимок сборки: реалайзер v5 хранит в нём цели структуры до переписывания
.sborka/

# промпты прогонов: пишутся на каждый запуск и ломают git pull
tmp/

# архивы партий: доставка, а не содержимое репозитория — сами наборы
# лежат распакованными в samples/v5-final, и зип дублировал бы их целиком
nabory-*.zip
