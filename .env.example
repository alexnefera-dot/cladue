# Доступ к Yandex Search API (Yandex Cloud). Скопируйте в .env и заполните.
# Идентификатор каталога Yandex Cloud
YANDEX_FOLDER_ID=
# API-ключ сервисного аккаунта с ролью search-api.webSearch.user
YANDEX_API_KEY=
# Вместо API-ключа можно передать IAM-токен (живёт 12 часов)
# YANDEX_IAM_TOKEN=

# Доступ к XMLStock (source = xmlstock): идентификатор пользователя и ключ из личного кабинета xmlstock.com
XMLSTOCK_USER=
XMLSTOCK_KEY=

# Система запусков dorgen: выгрузка НАШИХ запущенных поддоменов (страница «Разбор выдачи»
# помечает такие сайты «наш»). Проще вписать ключ в панели: «Настройки» → «Ключи доступа» —
# она сохранит его сюда сама. Здесь — для запуска из консоли. Без ключа выгрузка не используется.
DORGEN_BASE=https://dorgen-engine.com
DORGEN_TOKEN=
