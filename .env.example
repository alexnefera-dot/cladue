# Доступ к Yandex Search API (Yandex Cloud). Скопируйте в .env и заполните.
# Идентификатор каталога Yandex Cloud
YANDEX_FOLDER_ID=
# API-ключ сервисного аккаунта с ролью search-api.webSearch.user
YANDEX_API_KEY=
# Вместо API-ключа можно передать IAM-токен (живёт 12 часов)
# YANDEX_IAM_TOKEN=

# Доступ к XMLStock (source = xmlstock): идентификатор пользователя и ключ из личного кабинета xmlstock.com
XMLSTOCK_USER=
XMLSTOCK_KEY=
